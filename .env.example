#AWS CONFIG
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET=your-s3-bucket-name

#UPLOAD CONFIG
MAX_UPLOAD_BYTES=10485760

#BEDROCK CONFIG IN AWS
# BEDROCK_EMBED_MODEL=amazon.nova-2-multimodal-embeddings-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=us.amazon.nova-2-lite-v1:0
EMBED_DIM=1024

#OPENAI (EMBEDDINGS) AND ANTHROPIC (CHAT) - used instead of Bedrock
OPENAI_API_KEY=""
OPENAI_EMBED_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

#PINECONE CONFIG
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=umbrella-vectors
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

#POSTGRE SQL CONFIG
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

#RIUS OBSERVABILITY CONFIG
RIUS_API_KEY=""
RIUS_SERVICE_NAME=umbrella_ai
RIUS_DISABLED=False
RIUS_CAPTURE_CONTENT=False
