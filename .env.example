#AWS CONFIG
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET=your-s3-bucket-name

#UPLOAD CONFIG
MAX_UPLOAD_BYTES=10485760

#EMBEDDING SIZE (must match the Pinecone index)
EMBED_DIM=1024

#OPENAI (EMBEDDINGS) AND ANTHROPIC (CHAT)
OPENAI_API_KEY=""
OPENAI_EMBED_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

#PINECONE CONFIG
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=umbrella-vectors
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

#POSTGRE SQL CONFIG
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

#ACCESS: shared password for the whole app (the browser asks for it). Empty = no password.
#Set a long random one before putting the app on a public URL.
APP_PASSWORD=""

#RAG BEHAVIOUR
MIN_RELEVANCE=0.30
MEMORY_TURNS=6
HITL_ENABLED=True

#OBSERVABILITY: choose the tool and how much it records
# OBSERVABILITY_PROVIDER = langsmith | rius | none
# OBSERVABILITY_CAPTURE  = off (timing/errors) | metadata (+ token counts, model) | full (+ prompts and answers)
OBSERVABILITY_PROVIDER=langsmith
OBSERVABILITY_CAPTURE=metadata

#LANGSMITH (project is created automatically on the first trace)
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=umbrella

#RIUS OBSERVABILITY CONFIG
RIUS_API_KEY=""
RIUS_SERVICE_NAME=umbrella_ai
RIUS_DISABLED=False
